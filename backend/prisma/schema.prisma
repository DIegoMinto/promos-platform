generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENTE
  NEGOCIO
  ADMIN
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RedemptionStatus {
  REQUESTED
  REDEEMED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CheckoutStatus {
  OPEN
  COMPLETED
  CANCELLED
}


enum PaymentMethod {
  TRANSFER
  CASH_ON_PICKUP
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business?
  cart               Cart?
  checkoutSessions   Checkout[]
  orders             Order[]             @relation("CustomerOrders")
  reviewedPayments   PaymentSubmission[] @relation("PaymentReviewer")

  reviewedSubscriptionRequests SubscriptionRequest[] @relation("SubscriptionRequestReviewer")
  requestedRedemptions         PromotionRedemption[] @relation("RedemptionCustomer")
  validatedRedemptions         PromotionRedemption[] @relation("RedemptionValidator")
}

model Business {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  name        String
  description String?
  phone       String?
  logo        String?
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id])
  promotions           Promotion[]
  branches             Branch[]
  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]
  redemptions          PromotionRedemption[]
  deliveryEnabled     Boolean  @default(false)
  deliveryFee         Decimal  @default(0) @db.Decimal(10, 2)
  deliveryInstructions String?
  orders              Order[]

  paymentQrUrl         String?
  pickupEnabled        Boolean  @default(true)
}

model Branch {
  id         Int      @id @default(autoincrement())
  businessId Int
  name       String
  address    String
  city       String?
  phone      String?
  latitude   Float?
  longitude  Float?
  status     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business          @relation(fields: [businessId], references: [id])
  promotions PromotionBranch[]
  orders Order[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotions Promotion[]
}

model Promotion {
  id            Int      @id @default(autoincrement())
  businessId    Int
  categoryId    Int
  title         String
  description   String?
  image         String?
  originalPrice Decimal  @db.Decimal(10, 2)
  discountPrice Decimal  @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  status        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business              @relation(fields: [businessId], references: [id])
  category    Category              @relation(fields: [categoryId], references: [id])
  branches    PromotionBranch[]
  redemptions PromotionRedemption[]
  cartItems CartItem[]
  orderItems OrderItem[]
}

model PromotionBranch {
  promotionId Int
  branchId    Int

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([promotionId, branchId])
}

model Plan {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  description    String?
  monthlyPrice   Decimal  @db.Decimal(10, 2)
  promotionLimit Int?
  benefits       Json?
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]
  requests      SubscriptionRequest[]
}

model Subscription {
  id           Int                @id @default(autoincrement())
  businessId   Int
  planId       Int
  status       SubscriptionStatus @default(ACTIVE)
  monthlyPrice Decimal            @db.Decimal(10, 2)
  startDate    DateTime           @default(now())
  endDate      DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  business Business             @relation(fields: [businessId], references: [id])
  plan     Plan                 @relation(fields: [planId], references: [id])
  request  SubscriptionRequest?

  @@index([businessId, status])
  @@index([endDate])
}

model SubscriptionRequest {
  id             Int                       @id @default(autoincrement())
  businessId     Int
  planId         Int
  subscriptionId Int?                      @unique
  status         SubscriptionRequestStatus @default(PENDING)
  monthlyPrice   Decimal                   @db.Decimal(10, 2)
  message        String?
  adminNotes     String?
  reviewedById   Int?
  requestedAt    DateTime                  @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  plan         Plan          @relation(fields: [planId], references: [id])
  reviewedBy   User?         @relation("SubscriptionRequestReviewer", fields: [reviewedById], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([businessId, status])
  @@index([status, requestedAt])
}

model PromotionRedemption {
  id            Int              @id @default(autoincrement())
  code          String           @unique
  customerId    Int
  promotionId   Int
  businessId    Int
  status        RedemptionStatus @default(REQUESTED)
  requestedAt   DateTime         @default(now())
  expiresAt     DateTime?
  redeemedAt    DateTime?
  validatedById Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  customer    User      @relation("RedemptionCustomer", fields: [customerId], references: [id])
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  business    Business  @relation(fields: [businessId], references: [id])
  validatedBy User?     @relation("RedemptionValidator", fields: [validatedById], references: [id])

  orderItemId Int?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@index([customerId, requestedAt])
  @@index([businessId, status])
  @@index([promotionId, status])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}


model CartItem {
  id              Int             @id @default(autoincrement())
  cartId          Int
  promotionId     Int
  quantity        Int             @default(1)
  fulfillmentType FulfillmentType @default(DELIVERY)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([cartId, promotionId, fulfillmentType])
  @@index([promotionId])
}


model Checkout {
  id         Int            @id @default(autoincrement())
  reference  String         @unique
  customerId Int
  status     CheckoutStatus @default(OPEN)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer User    @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId, createdAt])
}

model Order {
  id                Int             @id @default(autoincrement())
  reference         String          @unique
  checkoutId        Int
  customerId        Int
  businessId        Int
  branchId          Int?
  fulfillmentType   FulfillmentType
  status            OrderStatus     @default(PENDING_PAYMENT)

  customerName      String
  customerPhone     String
  deliveryAddress   String?
  deliveryNotes     String?

  subtotal          Decimal         @db.Decimal(10, 2)
  deliveryFee       Decimal         @default(0) @db.Decimal(10, 2)
  total             Decimal         @db.Decimal(10, 2)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?

  checkout Checkout @relation(fields: [checkoutId], references: [id])
  customer User     @relation("CustomerOrders", fields: [customerId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  branch Branch?    @relation(fields: [branchId], references: [id])

  items   OrderItem[]
  payment Payment?

  @@index([customerId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([checkoutId])
}

model OrderItem {
  id                  Int      @id @default(autoincrement())
  orderId             Int
  promotionId         Int
  promotionTitle      String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(10, 2)
  lineTotal           Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now())

  order       Order                @relation(fields: [orderId], references: [id])
  promotion   Promotion            @relation(fields: [promotionId], references: [id])
  redemptions PromotionRedemption[]

  @@index([orderId])
  @@index([promotionId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  qrImageUrl    String?
  transferReference String?
  reviewNotes   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order       Order              @relation(fields: [orderId], references: [id])
  submissions PaymentSubmission[]
  
  paymentMethod PaymentMethod @default(TRANSFER)


  @@index([status, createdAt])
}

model PaymentSubmission {
  id             Int                     @id @default(autoincrement())
  paymentId      Int
  receiptUrl     String
  transferReference String?
  status         PaymentSubmissionStatus @default(PENDING)
  customerNote   String?
  reviewerNote   String?
  reviewedById   Int?
  submittedAt    DateTime                @default(now())
  reviewedAt     DateTime?

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("PaymentReviewer", fields: [reviewedById], references: [id])

  @@index([paymentId, submittedAt])
  @@index([status, submittedAt])
}